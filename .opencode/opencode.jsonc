{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "headroom_*": false,
    "serena_*": false,
    "playwright_*": false,
    "sequential-thinking_*": false,
    "firecrawl_*": false,
    "github_*": false,
    "postgres_*": false
  },
  "agent": {
    "headroom": {
      "description": "headroom operations",
      "mode": "subagent",
      "tools": {
        "headroom_*": true
      }
    },
    "serena": {
      "description": "serena operations",
      "mode": "subagent",
      "tools": {
        "serena_*": true
      }
    },
    "playwright": {
      "description": "playwright operations",
      "mode": "subagent",
      "tools": {
        "playwright_*": true
      }
    },
    "sequential-thinking": {
      "description": "sequential-thinking operations",
      "mode": "subagent",
      "tools": {
        "sequential-thinking_*": true
      }
    },
    "firecrawl": {
      "description": "firecrawl operations",
      "mode": "subagent",
      "tools": {
        "firecrawl_*": true
      }
    },
    "github": {
      "description": "github operations",
      "mode": "subagent",
      "tools": {
        "github_*": true
      }
    },
    "postgres": {
      "description": "postgres operations",
      "mode": "subagent",
      "tools": {
        "postgres_*": true
      }
    }
  }
}